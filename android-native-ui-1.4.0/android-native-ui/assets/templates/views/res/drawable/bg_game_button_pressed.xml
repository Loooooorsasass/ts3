<?xml version="1.0" encoding="utf-8"?>
<!-- TEMPLATE: pressed state. The face travels down by game_button_press_shift; the lip nearly disappears. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="@dimen/game_button_depth">
        <shape android:shape="rectangle">
            <solid android:color="@color/game_primary_lip" />
            <corners android:radius="@dimen/game_button_radius" />
        </shape>
    </item>
    <item
        android:top="@dimen/game_button_press_shift"
        android:bottom="@dimen/game_button_depth_remaining">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/game_primary_face_top"
                android:endColor="@color/game_primary_face_bottom" />
            <stroke
                android:width="@dimen/game_button_edge"
                android:color="@color/game_primary_edge" />
            <corners android:radius="@dimen/game_button_radius" />
        </shape>
    </item>
    <!-- Highlight, shifted by the same amount (API 23+): top = press_shift (4dp) + 5dp -->
    <item
        android:left="14dp"
        android:top="9dp"
        android:right="14dp"
        android:height="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/game_primary_highlight" />
            <corners android:radius="1dp" />
        </shape>
    </item>
</layer-list>
